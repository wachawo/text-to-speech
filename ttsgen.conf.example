# ttsgen.conf — KEY=VALUE template
#
# Copy to one of:
#   ./ttsgen.conf            (project-local, highest file priority)
#   ~/.config/ttsgen.conf    (user-wide; auto-created with defaults on first run)
#
# Lookup priority (highest wins):
#   1. Process env (shell vars, CLI flags like --coqui-model)
#   2. ./ttsgen.conf
#   3. ~/.config/ttsgen.conf
#   4. .env (legacy)
#   5. Built-in defaults baked into engine modules


# Default engine and language used when not specified on the command line.
# Engines: gtts, pyttsx3, pipertts, silerotts, coquitts, barktts, kokorotts.
TTS_ENGINE=gtts
TTS_LANGUAGE=en

# Server only (ttssrv): comma-separated engines to install + preload at startup.
# Empty = just TTS_ENGINE. Example: TTS_ENGINES=coquitts,silerotts
TTS_ENGINES=


# Default CLI output format(s). One or more of: play, file, stdout (comma-separated).
DEFAULT_OUTPUT_FORMAT=play


# Where saved audio goes for `--file` without an explicit path.
AUDIO_DIRECTORY=audio


# Optional filename prefix; empty = timestamp-only.
FILENAME_PREFIX=


# pyttsx3 (espeak) speech rate and volume — used only by the pyttsx3 engine.
AUDIO_RATE=150
AUDIO_VOLUME=0.9


# Piper TTS — model directory (.onnx files). Default: project-local cache/pipertts/.
PIPERTTS_MODELS=cache/pipertts


# Silero TTS — model directory. Default: project-local cache/silerotts/.
# Set to ~/.cache/torch/hub for the standard torch.hub layout.
SILEROTTS_MODELS=cache/silerotts


# Coqui TTS configuration.
COQUITTS_MODELS=cache/coquitts
# Full Coqui model identifier. Used at runtime AND by `ttsgen --install coquitts`.
# Common choices:
#   tts_models/multilingual/multi-dataset/xtts_v2          (best quality, voice cloning, ~1.8 GB, CPML license)
#   tts_models/en/ljspeech/tacotron2-DDC                   (English, fast, ~200 MB)
COQUITTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Voice sample WAV — required by xtts_v2 voice cloning at synthesis time.
COQUITTS_SAMPLE=~/.config/ttsgen.wav


# Bark TTS — model cache directory (large: ~10–15 GB).
BARKTTS_MODELS=cache/barktts


# Kokoro TTS — directory holding kokoro-v1.0.onnx + voices-v1.0.bin (~340 MB).
KOKOROTTS_MODELS=cache/kokorotts
# Default voice (override the per-language default like af_sarah / ff_siwis).
# See https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
# KOKOROTTS_VOICE=af_heart
# Speech speed multiplier (1.0 = normal).
# KOKOROTTS_SPEED=1.0


# HTTP API server (used by `ttssrv` and docker/{cpu,gpu}/docker-compose.yml).
TTS_HOST=0.0.0.0
TTS_PORT=5000
TTS_DEBUG=False
TZ=America/New_York
# Server auth: comma-separated bearer tokens. Empty (default) DISABLES auth.
# Example: TTS_TOKENS=alice-token,bob-token
TTS_TOKENS=
# Engine pool size for ttssrv (number of pre-warmed engine slots).
# 0 = unlimited concurrency, no warmup. 1+ = bound on parallel synthesis.
TTS_POOL_SIZE=1

# HTTP API client (used by `ttsapi` to reach a remote `ttssrv`).
# TTS_TOKEN must match one of TTS_TOKENS on the server when auth is enabled.
TTS_URL=http://localhost:5000
TTS_TOKEN=
