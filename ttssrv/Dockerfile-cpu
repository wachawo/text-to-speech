# CPU image — heavy ML stack (torch[cpu] + coqui-tts + transformers) baked in
# at build time via requirements-cpu.txt. Same architecture as Dockerfile (GPU);
# only difference is the torch wheel index. See Dockerfile for the full notes.
#
# Build context is ./ttssrv (this directory) — see docker-compose-cpu.yml.
FROM python:3.12-slim

WORKDIR /opt

RUN apt-get update && apt-get install -y --no-install-recommends \
        espeak espeak-data libespeak1 \
        ffmpeg \
        ca-certificates git curl \
    && rm -rf /var/lib/apt/lists/*

# requirements-cpu.txt = requirements.txt + torch[cpu] + coqui-tts[codec] +
# transformers. CPU torch is much smaller than CUDA torch (~200 MB vs ~3 GB).
COPY requirements.txt requirements-cpu.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-cpu.txt \
    && rm /tmp/requirements*.txt

# Server source — copied for standalone `docker run`; bind-mounted at runtime
# from ./ttssrv via compose volumes (so edits don't need a rebuild).
COPY __init__.py app1.py validators.py gu.py entrypoint.sh /opt/ttssrv/
RUN chmod +x /opt/ttssrv/entrypoint.sh

ENV PYTHONUSERBASE=/opt/userbase \
    PIP_CACHE_DIR=/opt/pip-cache

EXPOSE 5000
ENTRYPOINT ["sh", "/opt/ttssrv/entrypoint.sh"]
CMD ["python3", "/opt/ttssrv/app1.py"]
