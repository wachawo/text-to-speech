# TTS Configuration
# Copy this file to .env and modify as needed

# TTS Engine: gtts, pyttsx3, piper, or any custom engine in engines/
TTS_ENGINE=gtts

# Language code for TTS (2-letter code: en, ru, es, etc.)
TTS_LANGUAGE=en

# Default output format: play, file, bytesio
# Can specify multiple separated by comma: play,file
# Default: play
DEFAULT_OUTPUT_FORMAT=play

# Default audio directory for saved files
AUDIO_DIRECTORY=audio

# Default filename prefix (empty = timestamp only)
FILENAME_PREFIX=

# Audio quality settings (for pyttsx3)
AUDIO_RATE=150
AUDIO_VOLUME=0.9

# PiperTTS model directory
PIPERTTS_PATH=.pipertts
# SILERO TTS model directory
SILEROTTS_PATH=.silerotts
# Coqui TTS model directory
COQUITTS_PATH=.coquitts
COQUITTS_SAMPLE=samples/1.wav

# API server (Flask) — used by api/app1.py and docker-compose.yml
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=SuP3rS3cr3tK3y!
TZ=America/New_York
