# ttsgen / .env configuration template
#
# Copy this file to `.env` (in the working directory of `ttsgen`) and edit values.
# See also `ttsgen.conf.example` — same format, different lookup paths.
#
# Lookup priority (highest wins):
#   1. Process env (shell vars, CLI flags like --coqui-model)
#   2. ./ttsgen.conf
#   3. ~/.config/ttsgen.conf
#   4. .env (this file's target)
#   5. Built-in defaults

# TTS Engine: gtts, pyttsx3, pipertts, silerotts, coquitts, barktts.
TTS_ENGINE=gtts

# Language code for TTS (2-letter code: en, ru, es, etc.)
TTS_LANGUAGE=en

# Default output format: play, file, stdout (comma-separated for multi-output: play,file).
DEFAULT_OUTPUT_FORMAT=play

# Default audio directory for saved files.
AUDIO_DIRECTORY=audio

# Default filename prefix (empty = timestamp only).
FILENAME_PREFIX=

# Audio quality settings (used only by the pyttsx3 engine).
AUDIO_RATE=150
AUDIO_VOLUME=0.9

# Piper TTS — model directory (.onnx files). Default: project-local .pipertts/.
PIPERTTS_PATH=.pipertts

# Silero TTS — model directory. Default: project-local .silerotts/.
SILEROTTS_PATH=.silerotts

# Coqui TTS — model cache directory.
COQUITTS_PATH=.coquitts
# Full Coqui model identifier. Used at runtime and by `ttsgen --install coquitts`.
# Common choices:
#   tts_models/multilingual/multi-dataset/xtts_v2          (best quality, voice cloning, ~1.8 GB, CPML license)
#   tts_models/en/ljspeech/tacotron2-DDC                   (English, fast, ~200 MB)
COQUITTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Voice sample WAV — required by xtts_v2 for voice cloning at synthesis time.
COQUITTS_SAMPLE=~/.config/ttsgen.wav

# Bark TTS — model cache directory (large: ~10–15 GB on first download).
BARKTTS_PATH=.barktts

# API Server (ttssrv) — used by ttssrv/app1.py and docker-compose.yml.
# SECURITY: TTS_HOST=0.0.0.0 binds on every interface. If you run ttssrv
# outside Docker without a firewall, the server is reachable from the LAN
# even when TTS_TOKENS is empty (auth disabled). For local-only use bind
# 127.0.0.1 instead.
TTS_HOST=0.0.0.0
TTS_PORT=5000
TTS_DEBUG=False
TZ=America/New_York

# Server auth: comma-separated bearer tokens. Empty (default) DISABLES auth.
# Example: TTS_TOKENS=alice-token,bob-token
TTS_TOKENS=

# Engine pool size for ttssrv (number of pre-warmed engine slots).
# 0 = unlimited concurrency, no warmup. 1+ = bound on parallel synthesis.
TTS_POOL_SIZE=1

# Client-side (ttsapi): target URL + bearer token.
# TTS_TOKEN must match one of TTS_TOKENS on the server when auth is enabled.
TTS_URL=http://localhost:5000
TTS_TOKEN=
